{
  "expo": {
    "name": "Life's a game",
    "slug": "lifes-a-game",
    "description": "A small Expo (React Native) companion app that tracks life's daily wins, losses, and everything in between.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifes-a-game",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sajadhussain.lifesagame",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.sajadhussain.lifesagame",
      "adaptiveIcon": {
        "backgroundColor": "#5B21B6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B21B6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B21B6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
